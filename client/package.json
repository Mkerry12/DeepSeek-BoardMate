{
  "name": "deepseek-deskmate",
  "version": "0.1.0",
  "description": "DeepSeek Live2D 桌宠 (DS鲸鱼娘 + Ollama)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.deepseek.deskmate",
    "productName": "DeepSeekDeskMate",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "msedge-tts": "^2.1.0",
    "pixi.js": "^8.22.0",
    "untitled-pixi-live2d-engine": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
