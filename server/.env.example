# 复制为 .env 后修改

# 本地 Ollama 地址（后端和 Ollama 在同一台机器上，保持默认即可）
OLLAMA_URL=http://127.0.0.1:11434
# 使用的模型，必须是 `ollama list` 里有的
OLLAMA_MODEL=deepseek-r1:8b

# 访问令牌，逗号分隔，每个朋友发一个；留空则不鉴权（仅限本机调试！）
ACCESS_TOKENS=change-me-123

# 每个令牌每分钟最多请求次数
RATE_LIMIT_PER_MIN=20
# 同时生成的最大请求数（取决于显存，8B 模型一般 1~2）
MAX_CONCURRENCY=2
# 发给模型的最多历史消息条数
MAX_HISTORY=16
# 单条用户消息最大字符数
MAX_INPUT_CHARS=1000
# 客户端自定义人设的最大字符数
MAX_PERSONA_CHARS=1000
# 长期记忆（小鲸记得的事）拼进系统提示词的最大字符数
MEMORY_MAX_CHARS=500

# 朗读（微软 Edge 神经网络语音，需要服务器能访问外网）：默认音色、单句最大字数、每个令牌每分钟最多句数
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_MAX_CHARS=300
TTS_RATE_PER_MIN=90

# 后端监听地址；花生壳映射到 127.0.0.1:8000 即可
HOST=127.0.0.1
PORT=8000
