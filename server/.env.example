# 复制为 .env 后修改

# 本地 Ollama 地址（后端和 Ollama 在同一台机器上，保持默认即可）
OLLAMA_URL=http://127.0.0.1:11434
# 使用的模型，必须是 `ollama list` 里有的
OLLAMA_MODEL=deepseek-r1:8b

# 访问令牌（旧方式，仍然有效），逗号分隔。推荐改用令牌库：python -m deskmate_server.tokens add <朋友名字>
# 这里和令牌库都为空时不鉴权（仅限本机调试！）
# 下面是占位值，原样保留后端会拒绝启动：换成自己的长随机串，或者清空后用令牌库
ACCESS_TOKENS=REPLACE-ME-with-your-own-random-token

# 令牌库（SQLite，只存哈希），相对路径以 server/ 为基准；已在 .gitignore 里
DB_PATH=data/deskmate.db
# 可选：管理接口 /admin/tokens 的令牌（用很长的随机串）；留空则关闭管理接口，只用命令行管理
ADMIN_TOKEN=

# 每个令牌每分钟最多请求次数
RATE_LIMIT_PER_MIN=20
# 同时生成的最大请求数（取决于显存，8B 模型一般 1~2）
MAX_CONCURRENCY=2
# 发给模型的最多历史消息条数
MAX_HISTORY=16
# 单条用户消息最大字符数
MAX_INPUT_CHARS=1000
# 客户端自定义人设的最大字符数
MAX_PERSONA_CHARS=1000
# 长期记忆（小鲸记得的事）拼进系统提示词的最大字符数
MEMORY_MAX_CHARS=500

# 朗读只用本机的 GPT-SoVITS（api_v2.py，自定义音色、离线、占用显卡），安装见 doc/gpt-sovits.md。
# 没有别的语音：没配置音色、GPT-SoVITS 没启动 / 出错 / 排队太长时，/tts 返回 503，桌宠就不出声。
# 总开关（false = 整个服务器不朗读）、单句最大字数、每个令牌每分钟最多句数
TTS_ENABLED=true
TTS_MAX_CHARS=300
TTS_RATE_PER_MIN=90

# GPT-SoVITS api_v2 地址。用 Docker 运行后端时由 compose.yaml 改成 http://host.docker.internal:9880
GSV_URL=http://127.0.0.1:9880
# 音色预设文件（可以放多个音色，客户端设置里能选），格式见 server/voices.example.json；已被 git 忽略
GSV_VOICES_FILE=data/voices.json
# 不想写文件的话，也可以只用下面几项配一个音色（文件里没有同名音色时追加）。两样都没有 = 不朗读
# 参考音频：GPT-SoVITS 那台机器上能读到的 3~10 秒干净人声 wav（写绝对路径）
GSV_VOICE_NAME=default
GSV_REF_AUDIO=
# 参考音频里说的那句话（强烈建议填，留空会让首次合成慢很多）
GSV_PROMPT_TEXT=
# 参考音频的语言 / 要合成的文字的语言：zh en ja ko yue auto
GSV_PROMPT_LANG=zh
GSV_TEXT_LANG=zh
# 语速，别低于 0.9（时间拉伸会有电音）
GSV_SPEED=1.0
# 切句方式：cut0 = 不切（推荐，切开再拼容易爆音；长句由本服务按句切开）
GSV_TEXT_SPLIT_METHOD=cut0
# 返回格式：wav（默认，无损、兼容性最好，长句可以无缝拼接）或 ogg（体积约 1/10，内网穿透带宽小时可以试试）
GSV_MEDIA_TYPE=wav
# 单次请求超时秒数（刚启动时第一句要 10~30 秒）
GSV_TIMEOUT=120
# 单次发给 GPT-SoVITS 的最多字数，更长的按句切开、依次合成再拼接
GSV_MAX_CHARS=80
# 显卡串行合成，最多排队多少句；超出的句子不读
GSV_MAX_QUEUE=8
# 后端启动后在后台先合成一句「预热」，免得第一句话等 20 秒
GSV_WARMUP=true

# 后端监听地址；内网穿透映射到 127.0.0.1:8000 即可
HOST=127.0.0.1
PORT=8000

# 日志：级别（DEBUG / INFO / WARNING），格式 text 或 json（每个请求一行，含 request id、路径、状态码、耗时、令牌标签）
LOG_LEVEL=INFO
LOG_FORMAT=text
